rules_version = '2';

// All writes happen server-side via the Firebase Admin SDK (Cloud Run API
// routes, and the church-PC agent), which bypasses these rules entirely.
// These rules only govern what the browser client may read directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }

    match /masses/{massId} {
      allow read: if role() in ['admin', 'controller'];
      allow write: if false;
    }

    match /agent/{docId} {
      allow read: if role() in ['admin', 'controller'];
      allow write: if false;
    }

    match /activityLog/{entryId} {
      allow read: if role() == 'admin';
      allow write: if false;
    }

    match /commands/{docId} {
      allow read, write: if false;
    }

    match /config/{docId} {
      allow read, write: if false;
    }
  }
}

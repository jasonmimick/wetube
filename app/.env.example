# --- Firebase client config (public — see docs/MANUAL_SETUP.md Phase 2) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Set to "true" to use the local Firebase emulator suite instead of the real project.
NEXT_PUBLIC_USE_EMULATOR=

# Persistent link shown in the app so volunteers/visitors can always find
# past Masses, not just the one currently live.
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/channel/UCUtmH7wJ0FawlVbsWhLujSg

# --- Server-side only (no NEXT_PUBLIC_ prefix) ---
FIREBASE_PROJECT_ID=
# One of these two for the Admin SDK in production (Cloud Run); omit both
# locally to fall back to your own `gcloud`/`firebase login` credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- YouTube Data API (see docs/MANUAL_SETUP.md Phase 4) ---
# Omit all three to run in mock-broadcast mode (no real YouTube calls).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
YOUTUBE_STREAM_ID=

# --- Auto-shutoff failsafe (see vercel.json + api/cron/auto-shutoff) ---
# Any random string; Vercel Cron sends this as a bearer token so the cron
# route can't be triggered by anyone who just finds the URL.
CRON_SECRET=
# Optional, defaults to 2 if unset.
AUTO_SHUTOFF_HOURS=2

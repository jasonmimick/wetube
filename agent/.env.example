# Which streamer adapter to use: mock | obs | vmix
STREAMER=mock

# --- Firestore connection ---
# For local testing against the Firebase emulator, set this instead of
# providing real credentials:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8090
FIREBASE_PROJECT_ID=demo-wetube

# In production (church PC), point this at the service account key file
# downloaded per docs/MANUAL_SETUP.md:
# GOOGLE_APPLICATION_CREDENTIALS=C:\wetube-agent\service-account.json

# --- vMix (production) ---
VMIX_BASE_URL=http://127.0.0.1:8088

# --- OBS (Mac dry-run substitute for vMix, see docs/DESIGN-stream-control.md) ---
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

POLL_INTERVAL_MS=3000

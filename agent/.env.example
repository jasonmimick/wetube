# Which streamer adapter to use: mock | obs | vmix
STREAMER=mock

# --- Connection to the wetube web app ---
# The agent no longer talks to a database directly — it polls the web app
# over HTTPS. No service-account key, no cloud credentials on this machine.
WETUBE_APP_URL=https://wetube-mu.vercel.app

# Must match AGENT_SHARED_SECRET in the Vercel environment.
# Generate one with: openssl rand -base64 36
AGENT_SHARED_SECRET=

# How often to check for start/stop commands. The server throttles the
# heartbeat DB write independently (~30s), so polling fast is cheap.
POLL_INTERVAL_MS=3000
REQUEST_TIMEOUT_MS=15000

# --- vMix (production) ---
VMIX_BASE_URL=http://127.0.0.1:8088

# --- OBS (Mac dry-run substitute for vMix, see docs/DESIGN-stream-control.md) ---
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=

# Local status page port
AGENT_WEB_PORT=5757

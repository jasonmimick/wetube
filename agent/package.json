{
  "name": "wetube-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Runs on the church PC. Polls Firestore for start/stop commands and drives the streaming software (vMix in production, OBS or a mock for testing).",
  "type": "commonjs",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "mock-server": "node mock-vmix-server.js",
    "build:mac": "pkg . --targets node20-macos-arm64 --output dist/wetube-agent-mac --public-packages '*' --public",
    "build:win": "pkg . --targets node20-win-x64 --output dist/wetube-agent-win.exe --public-packages '*' --public",
    "build": "npm run build:mac && npm run build:win"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": "agent.js",
  "pkg": {
    "assets": [
      "status.html"
    ]
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  }
}
